# Скопируйте на сервере в .env. НЕ добавляйте .env в Git.

# Домен и почта для Caddy (автоматический HTTPS)
DOMAIN=example.com
EMAIL=admin@example.com

# Telegram
BOT_TOKEN=токен_от_BotFather
BOT_USERNAME=AtlantaCoinApp
ADMIN_IDS=976961244
SUPPORT_USERNAME=atlanta_holder

# Публичные адреса: ВСЕ по HTTPS, без localhost.
# Если статика лежит на Cloudflare Workers, укажите здесь домен Worker:
# PUBLIC_URL=https://gumroad-mini.workers.dev
# WEBAPP_URL=https://gumroad-mini.workers.dev/app/
# MARKET_URL=https://gumroad-mini.workers.dev/market/
PUBLIC_URL=https://example.com
WEBAPP_URL=https://example.com/app/
MARKET_URL=https://example.com/market/
HOST=0.0.0.0
PORT=3000

# Продакшен: без демо-входа
DEV_MODE=0

# База и платежи
DB_PATH=data/kustos.db
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=длинный_случайный_секрет
