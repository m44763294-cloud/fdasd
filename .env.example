# ── Gumroad ────────────────────────────────────────────────────────────────
# Скопируйте в .env и заполните. Без BOT_TOKEN работает демо-режим сайта.

# Telegram
BOT_TOKEN=
# На Bothost подставляется автоматически, иначе username определится через getMe
BOT_USERNAME=
# Telegram ID арбитров через запятую (узнать свой: команда /id в боте).
# Если не задано — используется владелец бота по умолчанию.
ADMIN_IDS=
SUPPORT_USERNAME=

# Адреса
# PUBLIC_URL можно не задавать: на хостинге (Bothost, Railway, Caddy) адрес
# определится сам по первому запросу. Задавайте вручную, если домен известен.
# PUBLIC_URL=https://your-domain.com
# WEBAPP_URL=https://your-domain.com/app/
# MARKET_URL=https://your-domain.com/market/
HOST=127.0.0.1
PORT=8080

# Режим: 1 — вход для разработки без Telegram (X-Dev-User), 0 — только Telegram
DEV_MODE=1

# База
DB_PATH=data/kustos.db

# Комиссии, %
FEE_CRYPTO=1.5
FEE_FIAT=2.5
MIN_FEE_USD=0.30
PAYMENT_TTL_MINUTES=45

# Платежи: mock (демо) или cryptopay (реальный приём крипты)
PAYMENT_PROVIDER=mock
CRYPTOPAY_TOKEN=
PAYMENT_WEBHOOK_SECRET=change-me-in-production

# Маркет: пополнение GRAM через Crypto Pay (PAYMENT_PROVIDER=cryptopay)
# Счёт выставляется в TOPUP_ASSET, GRAM зачисляются по курсу GRAM_PER_UNIT.
TOPUP_ASSET=TON
GRAM_PER_UNIT=1000
MARKET_MIN_TOPUP=25
MARKET_MIN_WITHDRAW=10

# Маркет: ручной перевод GRAM на этот кошелёк (резервный способ)
GRAM_RECEIVE_ADDRESS=
GRAM_RECEIVE_COMMENT=Gumroad GRAM topup
# Служебный аккаунт Telegram для приёма подарков (без @)
GIFT_RECEIVE_USERNAME=
